{
  "name": "zscaler-policy-simulator-legacy-api",
  "version": "1.0.1",
  "description": "Zscaler Policy Simulator Legacy API: standalone Zscaler policy simulator (ZIA, ZPA, Client Connector) over the legacy APIs, for GovCloud and other clouds without OneAPI",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/engine.test.js test/bulk.test.js test/legacy.test.js",
    "build": "pkg . --targets node20-win-x64,node20-macos-arm64,node20-macos-x64 --no-bytecode --public --public-packages \"*\" --out-path dist"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1"
  }
}
